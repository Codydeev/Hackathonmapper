{
  "name": "mesh-positioning-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx server/index.ts",
    "serve": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && tsx server/index.ts",
    "demo": "node scripts/demo.mjs",
    "watch": "nodemon",
    "typecheck": "tsc --noEmit",
    "sample": "node scripts/send-sample.mjs",
    "tunnel": "node scripts/tunnel.mjs",
    "tunnel:setup": "node scripts/tunnel-setup.mjs",
    "tunnel:install": "node scripts/install-cloudflared.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/three": "^0.170.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
